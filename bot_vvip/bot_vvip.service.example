[Unit]
Description=Telegram VVIP Bot
After=network.target

[Service]
# Ganti User, Group, WorkingDirectory, dan ExecStart sesuai dengan path dan user di VPS Anda
User=root
Group=root
WorkingDirectory=/root/bot_vvip
ExecStart=/root/bot_vvip/venv/bin/python3 bot.py
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
